// What Explorer shows for GitWallet.exe: its icon, version and publisher.
#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 2, 0, 0
PRODUCTVERSION 0, 2, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DOROBANTU.NET"
            VALUE "FileDescription", "GitWallet"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "GitWallet"
            VALUE "LegalCopyright", "Copyright (c) 2026 Dorobantu. MIT License."
            VALUE "OriginalFilename", "GitWallet.exe"
            VALUE "ProductName", "GitWallet"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
