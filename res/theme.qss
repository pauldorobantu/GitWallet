
/* ===== Theme generated by ThemeManager (dark/light, configurable accent/border/radius/font) ===== */
* { outline: none; }
/* Fundalul NU se pune pe orice QWidget — doar pe containerele-rădăcină care
   umplu spațiu. Altfel fiecare sub-container (capul unui card, o bară de
   butoane, un rând de formular) pictează o bandă pe culoarea paginii peste
   card/suprafață — exact „elementele neîncadrate". Restul rămân transparente
   (defaultul Qt) și moștenesc suprafața părintelui. */
QWidget { color: %TEXTSOFT%; font-family: "Segoe UI", "Inter", sans-serif; }
QMainWindow, QDialog, QMessageBox { background-color: %BG%; }
QLabel { background: transparent; }
QFrame { background: transparent; border: none; border-radius: 0; }
/* Rama aplicației: marginile 1px ale layout-ului (pe toate 4 laturile) lasă
   fundalul #appRoot vizibil ca bordură fină în culoarea temei. */
#appRoot { background-color: %WINDOWFRAME%; }
#cardPanel { background-color: %SURFACE%; border: %CARDBORDER%; border-radius: %RBIG%px; }
QToolTip { background-color: %SURFACE%; color: %TEXT%; border: 1px solid %BORDERS%;
           border-radius: %RSMALL%px; padding: 8px 10px; font-size: %FSMALL%px; }

/* ===== Inputs ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: %SURFACEALT%; color: %TEXT%; selection-background-color: %SEL%;
    selection-color: %TEXT%; border: 1px solid %BORDERS%; border-radius: %R%px;
    padding: 5px 10px; min-height: 0; font-size: %FBODY%px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus { border: 1px solid %ACCENT%; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: %MUTED%; }
/* Fără letter-spacing pe parolă: răsfira și placeholder-ul („O p t i o n a l")
   — punctele de parolă sunt lizibile și la spațierea normală. */
/* Înălțime uniformă: TOATE controalele au 32px border-box (câmp 30 + bordură
   2; buton 24 + padding 6 + bordură 2) — câmpurile și butoanele stau unul
   lângă altul perfect aliniate (feedback owner). Înainte: câmp 28 / buton 34. */
QLineEdit { padding: 0 10px; min-height: 30px; }
QComboBox, QSpinBox { padding: 0 8px; min-height: 30px; }
/* QLineEdit-ul intern al spinbox-ului prindea regula globală min-height:30 →
   spinbox-ul ieșea 35px (QLineEdit 30 + padding/bordură spin) în loc de 32,
   peste rândul de formular. Îl neutralizăm ca toate controalele să fie 32px. */
QAbstractSpinBox > QLineEdit { min-height: 0; padding: 0; border: none; background: transparent; }
/* Zonele multi-linie nu au o înălțime impusă de QSS (min-height: 0 de mai sus
   anula setMinimumHeight) → cel puțin 2-3 rânduri vizibile. */
QTextEdit, QPlainTextEdit { min-height: 60px; }
QComboBox::drop-down { border: none; width: 22px; }
/* Săgeata combo: chevron Lucide tintat în resurse — fără el, drop-down
   stilat lasă săgeata nativă nevizibilă pe dark. Hover/popup → varianta
   deschisă la culoare. */
QComboBox::down-arrow { image: url(:/icons/lucide/%CHEVMUTED%.svg); width: 14px; height: 14px; }
QComboBox::down-arrow:hover, QComboBox::down-arrow:on { image: url(:/icons/lucide/%CHEVSOFT%.svg); }
QComboBox QAbstractItemView {
    background-color: %SURFACE%; border: 1px solid %BORDERS%; border-radius: %R%px;
    selection-background-color: %SEL%; selection-color: %TEXT%; outline: none; padding: 4px;
}
/* Popup-ul combo: rânduri la înălțimea controlului (30px), nu text gol. */
QComboBox QAbstractItemView::item { min-height: 28px; }
QSpinBox::up-button, QSpinBox::down-button { background: transparent; border: none; width: 16px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: rgba(%HOVER%); border-radius: %RCHECK%px; }

/* ===== Butoane (secundar standard, identic cu #mimStart peste toată aplicația) =====
   Toate controalele = 32px border-box: min-height 30 (content) + 1px border
   sus/jos, FĂRĂ padding vertical. În QSS height/min-height sunt pe content-box,
   iar padding+border se adaugă — de aici veneau butoanele de 34px (3px padding
   × 2 + border) care depășeau rândurile și arătau strivite. */
QPushButton {
    background-color: %SURFACEALT%; color: %TEXT%;
    border: 1px solid %BORDERS%; border-radius: %RBTN%px;
    padding: 0 12px; min-width: 0; min-height: 30px; font-size: %FBODY%px;
    font-weight: 500;
}
QPushButton:hover { background-color: %HOVERSURF%; border-color: %ACCENT%; color: %ACCENT%; }
QPushButton:pressed { background-color: %SURFACE%; }
QPushButton:focus { border-color: %ACCENT%; }
QPushButton:disabled { color: %MUTED%; border-color: %BORDER%; background-color: %SURFACE%; }
/* Butoanele din dialoguri uniforme (fără OK pătrat vs. Cancel îngust). */
QDialogButtonBox QPushButton, QMessageBox QPushButton { min-width: 64px; }
/* Mesajele (QMessageBox) și QInputDialog le dimensionează Qt la ~250px: textul
   ieșea înghesuit pe multe rânduri. Lățime minimă de citit confortabil. */
QMessageBox QLabel#qt_msgbox_label, QMessageBox QLabel#qt_msgbox_informativelabel {
    min-width: 420px; }
QInputDialog QLineEdit, QInputDialog QComboBox, QInputDialog QSpinBox { min-width: 420px; }
/* Primarul: bordură în accent (nu „none") ca să aibă aceeași înălțime de 32px. */
#primaryButton { background-color: %ACCENT%; color: %ACCENTTEXT%;
                 border: 1px solid %ACCENT%; font-weight: 600; }
#primaryButton:hover { background-color: %ACCENTHOVER%; color: %ACCENTTEXT%; border-color: %ACCENTHOVER%; }
#primaryButton:pressed { background-color: %ACCENTPRESSED%; border-color: %ACCENTPRESSED%; }
#primaryButton:disabled { background-color: %SURFACEALT%; color: %MUTED%; border: 1px solid %BORDER%; }
#dangerButton { background-color: rgba(%ERROR%,0.12); color: %ERROR%;
                border: 1px solid rgba(%ERROR%,0.4); }
#dangerButton:hover { background-color: rgba(%ERROR%,0.2); border-color: %ERROR%; color: %ERROR%; }
#dangerButton:pressed { background-color: rgba(%ERROR%,0.26); border-color: %ERROR%; color: %ERROR%; }
QToolButton { background: transparent; border: none; border-radius: %RSMALL%px; color: %TEXTSOFT%; }
QToolButton:hover { background-color: rgba(%HOVER%); }
QToolButton:pressed { background-color: rgba(0,0,0,0.12); }


/* ===== Tables (single "card" skin for all pages: surface + subtle border) ===== */
/* Zebra, hover și selecția NU se pictează per celulă: le desenează un singur
   strat sub conținut, pe tot rândul (ui::RowBands / HoverRowTable) — o
   singură nuanță uniformă, fără petice sau muchii verticale între coloane.
   Celulele rămân transparente (alternate/selection/hover). */
QTableView, QTableWidget, #dataTable, #rowTable {
    background-color: %TBBG%; alternate-background-color: transparent;
    border: 1px solid %TBBORDER%; border-radius: %TBRADIUS%; gridline-color: %TBGRID%;
    selection-background-color: transparent; selection-color: %TEXT%; font-size: %FBODY%px;
}
QTableView::item:hover, QTableWidget::item:hover { background-color: transparent; }
QTableView::item, QTreeView::item, QListView::item { min-height: 0; padding: 4px 10px; }
QTableView::item:selected, QTableWidget::item:selected { background: transparent; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: %TBHEADBG%; color: %MUTED%; border: none;
    border-right: none; border-bottom: 1px solid %TBBORDER%;
    /* 13px stânga = padding-ul celulei (10) + marginea internă de ~3px pe care
       Qt o adaugă în item-uri; aliniază antetul cu textul din celule. */
    padding: 6px 10px 6px 13px; font-size: %FSMALL%px; font-weight: 600; letter-spacing: 0.3px;
    min-height: 22px;
}
QTableCornerButton::section { background-color: %TBHEADBG%; border: none; }

/* ===== Tabs ===== */
QTabWidget::pane { border: none; border-top: 1px solid %BORDERS%; background: %BG%; }
QTabBar::tab {
    background: transparent; color: %MUTED%; padding: 8px 16px; min-height: 0;
    border-bottom: 2px solid transparent; font-size: %FBODY%px;
}
QTabBar::tab:hover { color: %TEXT%; }
QTabBar::tab:selected { color: %ACCENT%; border-bottom: 2px solid %ACCENT%; font-weight: 600; }

/* ===== Lists ===== */
QListWidget, QListView, QTreeView { background-color: transparent; border: none; font-size: %FBODY%px; }
QListWidget::item { padding: 6px 10px; border-radius: %RSMALL%px; }
QListWidget::item:hover { background-color: rgba(%HOVER%); }
QListWidget::item:selected { background-color: %SEL%; color: %TEXT%; }
/* Vault: group items are click targets, not table rows — 28px. */
#vaultTree::item { min-height: 28px; }

/* ===== Thin scrollbar ===== */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: %BORDERS%; border-radius: %RBAR%px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: %MUTED%; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: %BORDERS%; border-radius: %RBAR%px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: %MUTED%; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ===== Menus / popups =====
   Item = a desktop click target: ~32px (font 13.5 + padding 8), aligned with
   the 30px buttons; the separator breathes the same. */
QMenu { background-color: %SURFACE%; border: 1px solid %BORDERS%; border-radius: %R%px; padding: 6px; }
QMenu::item { padding: 8px 24px; border-radius: %RSMALL%px; color: %TEXTSOFT%; }
QMenu::item:selected { background-color: %SEL%; color: %TEXT%; }
QMenu::item:disabled { color: %MUTED%; }
QMenu::separator { height: 1px; background: %BORDER%; margin: 6px 10px; }

/* ===== Small controls ===== */
QCheckBox { background: transparent; color: %TEXTSOFT%; spacing: 10px; font-size: %FBODY%px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid rgba(%MUTEDRGB%,0.55); background: %SURFACEALT%; }
QCheckBox::indicator { border-radius: %RCHECK%px; }
QCheckBox::indicator:checked { background: %ACCENT%; border-color: %ACCENT%; }
/* Bifa albă pe indicatorul bifat — fără ea era doar un pătrat verde gol
   (arăta neterminat). */
QCheckBox::indicator:checked { image: url(:/icons/lucide/%CHECK%.svg); }
QCheckBox::indicator:hover { border-color: %ACCENT%; }
/* Bifele din liste/tabele (item checkable): fără reguli proprii ieșeau ca un
   pătrat negru nativ pe dark (ex. lista de domenii din Access URLs). */
QAbstractItemView::indicator { width: 16px; height: 16px; border: 1px solid rgba(%MUTEDRGB%,0.55);
    border-radius: %RCHECK%px; background: %SURFACEALT%; }
QAbstractItemView::indicator:checked { background: %ACCENT%; border-color: %ACCENT%;
    image: url(:/icons/lucide/%CHECK%.svg); }
QAbstractItemView::indicator:hover { border-color: %ACCENT%; }
QCheckBox:disabled { color: %MUTED%; }
/* ===== GroupBox = secțiune (ca PageKit::makeSection): card pe suprafață,
   titlul ÎNĂUNTRU sus-stânga (nu tăiat în ramă), același padding 20/16. ===== */
QGroupBox {
    background-color: %SURFACE%; border: %CARDBORDER%; border-radius: %RBIG%px;
    margin-top: 0; padding: 46px 20px 16px 20px;
}
QGroupBox::title {
    subcontrol-origin: padding; subcontrol-position: top left; left: 20px; top: 16px;
    padding: 0; color: %TEXT%; font-size: %FBIG%px; font-weight: 600;
}
QProgressBar { background-color: %SURFACEALT%; border: none; border-radius: %RBAR%px;
               height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background-color: %ACCENT%; border-radius: %RBAR%px; }
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: %BORDER%; }

/* ===== Title bar (frameless, seamless — Claude desktop style) ===== */
#titleBar { background-color: %BG%; border: none; }
/* NO min-width/min-height: 0 here — it would override the minimum from the
   caption buttons' setFixedSize (38×38) and the layout would shrink them to
   sizeHint (~19px); exactly the "buttons aren't square" bug. */
#titleBar QToolButton { background: transparent; border: none; border-radius: 0;
                        padding: 0; color: %TEXTSOFT%; }
#titleBar QToolButton:hover { background-color: rgba(%HOVER%); color: %TEXT%; }
#titleBar QToolButton:pressed { background-color: rgba(0,0,0,0.22); color: %TEXT%; }
QToolButton#tbClose:hover { background-color: rgb(%ERROR%); color: #ffffff; }
QToolButton#tbClose:pressed { background-color: rgba(0,0,0,0.28); color: #ffffff; }
/* Selector limbă + comutator temă din bara de titlu. */
#titleBar QToolButton#tbLang { padding: 0 9px; border-radius: %RNAV%px; color: %TEXTSOFT%;
    font-size: 12px; font-weight: 600; letter-spacing: 0.4px; }
#titleBar QToolButton#tbLang:hover { background-color: rgba(%HOVER%); color: %TEXT%; }
#titleBar QToolButton#tbLang::menu-indicator, #titleBar QToolButton#tbTheme::menu-indicator { image: none; width: 0; }
#titleBar QToolButton#tbTheme { border-radius: %RNAV%px; }

/* ===== Sidebar MEmu-style (expanded ↔ icon-only rail) ===== */
#sideNav { background-color: %SIDE%; border-right: 1px solid %BORDER%; }
#sideNav QScrollArea, #navScroll, #navScrollHost { background: transparent; border: none; }
#navBrand { color: %TEXT%; font-size: 14px; font-weight: 700; letter-spacing: 0.3px;
            background: transparent; }
#navSection { color: %MUTED%; font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
              padding: 14px 12px 6px 12px; background: transparent; }
#navItem {
    background: transparent; border: none; border-radius: %RNAV%px; color: %TEXTSOFT%;
    padding: 0 12px; font-size: %FNAV%px; text-align: left;
}
#navItem:hover { background-color: rgba(%HOVER%); color: %TEXT%; }
#navItem[active="true"] { background-color: rgba(%ACCENTRGB%,0.16); color: %ACCENT%; font-weight: 600; }
#navFloating { background-color: %SURFACE%; border: 1px solid %BORDERS%;
               border-radius: %RNAV%px; padding: 6px 12px; color: %TEXT%;
               font-size: %FBODY%px; font-weight: 600; }
/* Profile section at the bottom of the sidebar (ProfileChip) + its popup
   (ProfileMenu): the nav item's states, the QMenu's panel. */
#navFooter { background: transparent; border: none; border-top: 1px solid %BORDER%; }
#profileChip { background: transparent; border: none; border-radius: %RNAV%px;
               font-size: %FNAV%px; }
#profileChip:hover, #profileChip:focus { background-color: rgba(%HOVER%); }
#profileChip:pressed { background-color: rgba(%PRESS%); }
#profileMenuPopup { background: transparent; }
#profileMenu { background-color: %SURFACE%; border: 1px solid %BORDERS%; border-radius: %R%px; }
#profileMenuName { color: %TEXT%; font-size: %FBIG%px; font-weight: 600; }
#profileMenuEmail { color: %MUTED%; font-size: %FNAVSUB%px; }
#profileMenuSection { color: %MUTED%; font-size: %FSMALL%px; font-weight: 600;
                      letter-spacing: 0.4px; }
#profileMenuKey { color: %MUTED%; font-size: %FNAVSUB%px; }
#profileMenuValue { color: %TEXT%; font-size: %FNAVSUB%px; font-weight: 600; }
#profileMenuNote { color: %MUTED%; font-size: %FNAVSUB%px; }
#profileMenu QLabel[tone="ok"] { color: rgb(%SUCCESS%); }
#profileMenu QLabel[tone="warning"] { color: rgb(%WARNING%); }
#profileMenu QLabel[tone="error"] { color: rgb(%ERROR%); }
#profileMenuDot { border-radius: %RBAR%px; background-color: %MUTED%; }
#profileMenu QLabel#profileMenuDot[tone="ok"] { background-color: rgb(%SUCCESS%); }
#profileMenu QLabel#profileMenuDot[tone="warning"] { background-color: rgb(%WARNING%); }
#profileMenu QLabel#profileMenuDot[tone="error"] { background-color: rgb(%ERROR%); }
#profileMenuRule { background-color: %BORDER%; border: none; margin: 0 10px; } /* = QMenu::separator */
#profileMenuItem { background: transparent; border: none; border-radius: %RSMALL%px;
                   font-size: %FNAV%px; }
#profileMenuItem:hover, #profileMenuItem:focus { background-color: rgba(%HOVER%); }
#profileMenuItem:pressed { background-color: rgba(%PRESS%); }
#appName { color: %TEXT%; font-size: 13px; font-weight: 600;
           letter-spacing: 0.4px; background: transparent; }
#tbStatusChip {
    background-color: rgba(%HOVER%); border: 1px solid %BORDER%;
    border-radius: %RPILL%px;
}
#tbStatusText { color: %TEXTSOFT%; font-size: 12px; background: transparent; }
#tbStatus { color: %MUTED%; font-size: 12px; background: transparent; }

/* ===== Pages ===== */
#pageStack { background-color: %BG%; }
#statValue { color: %TEXT%; font-size: 22px; font-weight: 600; background: transparent; }
#pageTitle { color: %TEXT%; font-size: %FTITLE%px; font-weight: 600; background: transparent; }
/* "Hero" titles (About, Service settings): full text color, not textSoft. */
#mimName { color: %TEXT%; font-weight: 700; background: transparent; }
#pageDescription { color: %MUTED%; font-size: %FDESC%px; background: transparent; }
#countLabel, #mutedLabel { color: %MUTED%; background: transparent; }
/* Secțiuni (PageKit::makeSection): titlu + descriere, aceleași peste tot. */
#sectionTitle { color: %TEXT%; font-size: %FBIG%px; font-weight: 600; background: transparent; }
#sectionDesc { color: %MUTED%; font-size: %FBODY%px; background: transparent; }
#formSectionLabel { color: %TEXTSOFT%; font-size: %FDESC%px; font-weight: 600; background: transparent; padding-top: 2px; }
#emptyState { color: %MUTED%; font-size: %FBIG%px; background: transparent; }
#emptyState QLabel { background: transparent; color: %MUTED%; }
#emptyTitle { color: %TEXTSOFT%; font-size: %FBIG%px; font-weight: 600; background: transparent; }
#emptySub { color: %MUTED%; font-size: %FBODY%px; background: transparent; min-width: 340px; }
#flowState { background: transparent; }
#flowDisplay { background: transparent; color: %TEXT%; }
#flowError { background: transparent; color: rgb(%ERROR%); }
/* Fereastra Session details: banda de sus + titlu + chip variantă. */
#detailsHeader { background-color: %SIDE%; border-bottom: 1px solid %BORDER%; }
#detailsTitle { color: %TEXT%; font-size: 16px; font-weight: 600; background: transparent; }
#detailsChip { color: %TEXTSOFT%; background-color: rgba(%HOVER%); border: 1px solid %BORDER%;
               padding: 2px 10px; border-radius: %RPILL%px; font-size: 12px; }

/* ===== MEmu Multi — Multiple Instance Manager (Profiles page) =====
   Fixed palette captured from MEmuConsole: background #1e1f22, alternating
   rows #232529, borders #33353a, toolbar #3a4048, accent #2bbd8e. */

#mimRoot { background-color: %BG%; }
#mimToolbar, #mimOpsCell { background: transparent; }
/* Butoane secundare (Start/Close/Import/Refresh): surface + bordură crisp. */
#mimStart, #mimClose, #mimImport, #mimBtn {
    background-color: %SURFACEALT%; color: %TEXT%; border: 1px solid %BORDERS%;
    border-radius: %RBTN%px; padding: 0 12px; min-height: 30px; max-height: 30px;
    font-size: 12.5px; font-weight: 500;
}
#mimStart:hover, #mimClose:hover, #mimImport:hover, #mimBtn:hover {
    background-color: %HOVERSURF%; border-color: %ACCENT%; color: %ACCENT%;
}
#mimStart:pressed, #mimClose:pressed, #mimImport:pressed, #mimBtn:pressed {
    background-color: %SURFACE%;
}

#mimNew {
    background-color: %ACCENT%; color: %ACCENTTEXT%; border: 1px solid %ACCENT%;
    border-radius: %RBTN%px; padding: 0 14px; min-height: 30px; max-height: 30px;
    font-size: 12.5px; font-weight: 600;
}
#mimNew:hover { background-color: %ACCENTHOVER%; border-color: %ACCENTHOVER%; }
#mimNew:pressed { background-color: %ACCENTPRESSED%; border-color: %ACCENTPRESSED%; }

/* Butoane-icon pe rânduri/celule: 26×26, țintă confortabilă. */
#mimIconBtn, #mimRowBtn {
    background: transparent; border: none; border-radius: %RSMALL%px;
    min-width: 26px; min-height: 26px; max-width: 26px; max-height: 26px; padding: 0;
}
#mimIconBtn:hover, #mimRowBtn:hover { background-color: rgba(%HOVER%); }
#mimIconBtn:pressed, #mimRowBtn:pressed { background-color: rgba(%PRESS%); }
/* Fără săgeata de meniu nativă: strică icon-ul de 26px (Sort/Filter). */
#mimIconBtn::menu-indicator, #mimRowBtn::menu-indicator { image: none; width: 0; }

#mimSearch {
    background-color: %SURFACE%; color: %TEXT%; border: 1px solid %BORDERS%;
    border-radius: %RSEARCH%px; padding: 0 13px; min-height: 30px; max-height: 30px;
    font-size: 12.5px; selection-background-color: %SEL%;
}
#mimSearch:focus { border-color: %ACCENT%; }

#mimTable {
    background-color: %SURFACE%; alternate-background-color: transparent;
    border: 1px solid %BORDER%; border-radius: %RBIG%px; gridline-color: transparent;
    selection-background-color: transparent; selection-color: %TEXT%;
    font-size: 12px;
}
/* Benzile de rând (zebra/hover/selecție) le pictează HoverRowTable sub conținut. */
#mimTable::item:hover, #rowTable::item:hover { background-color: transparent; }
#mimTable::item:selected, #rowTable::item:selected { background: transparent; }
#mimTable QHeaderView::section {
    background-color: %SURFACE%; color: %MUTED%; border: none;
    border-bottom: 1px solid %BORDER%; padding: 6px 10px 6px 13px; font-size: %FSMALL%px;
    font-weight: 600; min-height: 22px;
}
#mimTable QTableCornerButton::section { background-color: %SURFACE%; border: none; }
#mimTable::item { min-height: 0; padding: 4px 10px; }

/* NU `spacing: 0` aici: regula ajunge și la bifele dialogurilor copil (QSS
   prinde descendenții peste ferestre prin părinte) și lipea textul de pătrat
   (ex. Uppercase/Digits/Symbols). Spacing-ul rămâne cel global (10px). */
#mimRoot QCheckBox { background: transparent; }
#mimRoot QCheckBox::indicator {
    /* Contur pe muted (ca bifele globale): %BORDERS% se pierdea pe rândurile dark. */
    width: 16px; height: 16px; border: 1px solid rgba(%MUTEDRGB%,0.55); border-radius: %RCHECK%px;
    background: %SURFACEALT%;
}
#mimRoot QCheckBox::indicator:checked { background: %ACCENT%; border-color: %ACCENT%;
    image: url(:/icons/lucide/%CHECK%.svg); }
#mimRoot QCheckBox::indicator:hover { border-color: %ACCENT%; }


#mimCount { color: %MUTED%; background: transparent; font-size: 12px; }
#mimRoot #emptyState { color: %MUTED%; }

/* Services: exclusive Select button */
#mimSelectBtn {
    background-color: %SURFACEALT%; color: %TEXT%; border: 1px solid %BORDERS%;
    border-radius: %RBTN%px; padding: 0 12px; min-height: 30px; max-height: 30px;
    font-size: 12.5px;
}
#mimSelectBtn:hover { background-color: %HOVERSURF%; border-color: %ACCENT%; }
#mimSelectBtn:checked {
    background-color: rgba(%ACCENTRGB%,0.18); color: %ACCENT%;
    border: 1px solid rgba(%ACCENTRGB%,0.45); font-weight: 600;
}

/* ===== Components (ui/design/Style.h): a widget says what it is through a
   dynamic property — tone, variant — and these rules draw it. ===== */
/* Tones (ui::setTone, ui::setStatus): a label's text in the colour of its meaning. */
QLabel[tone="muted"] { color: %MUTED%; }
QLabel[tone="accent"] { color: %ACCENT%; }
QLabel[tone="success"] { color: rgb(%SUCCESS%); }
QLabel[tone="warning"] { color: rgb(%WARNING%); }
QLabel[tone="error"] { color: rgb(%ERROR%); }
/* Chips (ui::setChip): a small tag tinted in its tone. */
QLabel[variant="chip"] { border-radius: %RCHIP%px; padding: 2px 10px; font-weight: 600; }
QLabel[variant="chip"][tone="muted"] { background: rgba(%MUTEDRGB%,28); border: 1px solid %MUTED%; }
QLabel[variant="chip"][tone="accent"] { background: rgba(%ACCENTRGB%,28); border: 1px solid %ACCENT%; }
QLabel[variant="chip"][tone="success"] { background: rgba(%SUCCESS%,28); border: 1px solid rgb(%SUCCESS%); }
QLabel[variant="chip"][tone="warning"] { background: rgba(%WARNING%,28); border: 1px solid rgb(%WARNING%); }
QLabel[variant="chip"][tone="error"] { background: rgba(%ERROR%,28); border: 1px solid rgb(%ERROR%); }
/* A dashboard value in a tone: #statValue sets its own colour, and an id
   outranks the tone rules above. */
#statValue[tone="accent"] { color: %ACCENT%; }
